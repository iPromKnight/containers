# Get upstream code
FROM alpine:latest AS cloner
ARG VERSION
RUN apk add --update --no-cache git \
    && git clone --depth 1 -b $VERSION https://github.com/Dictionarry-Hub/profilarr.git /source

# -----------------------------------------------------------------------------
# Stage 1: build the standalone Deno binary
# -----------------------------------------------------------------------------
# As of v2.0 profilarr is a Deno + SvelteKit + Vite project. Upstream's own
# Dockerfile uses denoland/deno:2.7.12 — we copy that pattern exactly so the
# build steps stay in lockstep with upstream regardless of how their build
# evolves; we only diverge in the final stage to base on our standard ubuntu.
FROM denoland/deno:2.7.12 AS build
WORKDIR /build

COPY --from=cloner /source/deno.json /source/deno.lock ./
COPY --from=cloner /source/. .

RUN deno install --node-modules-dir

ARG TARGETARCH
ARG VITE_CHANNEL=stable
ENV VITE_PLATFORM=docker-${TARGETARCH}
ENV VITE_CHANNEL=${VITE_CHANNEL}

# Inject build metadata so the version/channel show up in the UI. Mirrors
# the file upstream's Dockerfile generates.
ARG VERSION=dev
ARG CHANNEL=main
RUN cat > src/lib/shared/build.ts <<EOF
// Generated by Dockerfile at image build time. Do not hand-edit.
export type Channel = 'stable' | 'develop' | 'dev';

export interface BuildInfo {
	readonly version: string;
	readonly channel: Channel;
	readonly commit: string | null;
	readonly builtAt: string | null;
}

export const build: BuildInfo = {
	version: '${VERSION}',
	channel: '${VITE_CHANNEL}',
	commit: null,
	builtAt: null
};
EOF

ENV APP_BASE_PATH=/build/dist/build
RUN deno run -A npm:vite build

RUN DENO_TARGET=$(case "${TARGETARCH}" in \
        arm64) echo "aarch64-unknown-linux-gnu" ;; \
        *)     echo "x86_64-unknown-linux-gnu" ;; \
    esac) \
    && deno compile \
        --no-check \
        --allow-net \
        --allow-read \
        --allow-write \
        --allow-env \
        --allow-ffi \
        --allow-run \
        --allow-sys \
        --target "$DENO_TARGET" \
        --output dist/build/profilarr \
        dist/build/mod.ts

# -----------------------------------------------------------------------------
# Stage 2: final runtime image — promknight ubuntu base + the compiled binary
# -----------------------------------------------------------------------------
FROM ghcr.io/ipromknight/ubuntu:rolling

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG VERSION
ARG CHANNEL

USER root

# Runtime deps:
# - libsqlite3-0: profilarr's compiled binary dlopens libsqlite3 at runtime
#   (DENO_SQLITE_PATH below points to /usr/lib/$(uname -m)-linux-gnu/...)
# - git, tar: profilarr clones/extracts PCD repositories and creates backups
# - curl: healthcheck + our base wait-for-urls helper
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libsqlite3-0 \
        tar \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build --chown=568:568 /build/dist/build/profilarr /app/profilarr
COPY --from=build --chown=568:568 /build/dist/build/server.js /app/server.js
COPY --from=build --chown=568:568 /build/dist/build/static    /app/static

RUN chmod +x /app/profilarr

ENV PORT=6868 \
    HOST=0.0.0.0 \
    APP_BASE_PATH=/config \
    TZ=UTC

EXPOSE 6868
VOLUME ["/config"]

USER 568

COPY --chmod=0755 apps/profilarr/promknight-entrypoint.sh /promknight-entrypoint.sh

LABEL org.opencontainers.image.title="Profilarr"
LABEL org.opencontainers.image.description="Profilarr - Profile manager for *arr apps"
LABEL org.opencontainers.image.source="https://github.com/Dictionarry-Hub/profilarr"
LABEL org.opencontainers.image.authors="Dictionarry dictionarry@pm.me"
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
